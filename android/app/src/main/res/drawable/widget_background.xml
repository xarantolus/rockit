<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and up expect a widget to round its own corners to the system
  radius; without this it sits square inside the launcher's rounded cell and
  looks broken. The dimension only exists from API 31, hence values-v31.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_corner_radius" />
    <solid android:color="@color/widget_background" />
</shape>
