<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="widget_corner_radius">16dp</dimen>

    <!--
      The provider works out how many rows fit from these, so they must stay in
      step with the layout. The text blocks are declared in sp on purpose:
      Resources.getDimension applies the user's font scale to sp and not to dp,
      so a large-text device gets fewer rows instead of a clipped last one.

      These are measured off a screenshot, not derived from the text sizes. A
      14sp line plus a 12sp one is 26sp of text but 35sp of laid-out height —
      the default line spacing is nearer 1.35 than the 1.17 it is tempting to
      assume — and estimating it low is exactly what sliced the last row in
      half. They round up, so the error is a little empty space rather than a
      clipped row.
    -->
    <dimen name="widget_padding">12dp</dimen>
    <dimen name="widget_header_block">26sp</dimen>
    <dimen name="widget_row_text">36sp</dimen>
    <!-- Referenced by the row layout, so the provider's arithmetic and the
         padding it is dividing by cannot drift apart. -->
    <dimen name="widget_row_padding">4dp</dimen>
</resources>
