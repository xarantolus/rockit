<?xml version="1.0" encoding="utf-8"?>
<!--
  Ten identical rows in the layout would otherwise be ten copies of the same
  attributes. The heights these imply are also what the provider divides the
  widget's height by, so they are declared once here and once in dimens.xml
  rather than ten times each.
-->
<resources>
    <style name="RockItWidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <!--
      An ImageView and not a View: RemoteViews accepts only a fixed set of
      widget classes and a plain View is not one of them, so it would fail at
      inflate time on the device rather than at build time.

      Fixed height on purpose. Matching the row's height would mean a
      match_parent child inside a wrap_content parent, which measures
      unreliably; the bar is decoration, so a stable 30dp centred against the
      text is the safer trade.
    -->
    <style name="RockItWidgetAccent">
        <item name="android:layout_width">3dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/widget_row_accent</item>
    </style>

    <style name="RockItWidgetRowText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="RockItWidgetTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="RockItWidgetWhen">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/widget_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
