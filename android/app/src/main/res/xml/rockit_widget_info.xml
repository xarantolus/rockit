<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 0 deliberately: Android will not honour anything under
  half an hour anyway, and the app schedules its own one-off refresh for the
  moment the text actually goes stale — the turn of the day, or the top entry
  passing. Letting the system poll as well would redraw for nothing.

  The resize range is what makes the row count worth deciding at draw time:
  the provider fills whatever height the user drags it to, up to the ten rows
  the layout declares.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/rockit_widget"
    android:previewLayout="@layout/rockit_widget"
    android:description="@string/widget_description"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:maxResizeWidth="512dp"
    android:maxResizeHeight="1200dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0" />
