<?xml version="1.0" encoding="utf-8"?>
<!--
  One row, added to the widget once per launch by the provider.

  The rows used to be written out in the main layout, once per possible row,
  because a RemoteViews *tree* cannot be built at runtime — but RemoteViews.addView
  can append a nested tree, which is the supported way to do a variable-length
  list without a collection widget. That is what lets the maximum be 25 rather
  than however many were worth copying by hand.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!--
      An ImageView and not a View: RemoteViews accepts only a fixed set of
      widget classes and a plain View is not one of them, so it would fail at
      inflate time on the device rather than at build time.
    -->
    <ImageView
        android:layout_width="3dp"
        android:layout_height="30dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="10dp"
        android:background="@drawable/widget_row_accent"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
