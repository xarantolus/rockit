{
  "name": "Rock It! (Flutter + Android)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "root",
  "containerUser": "root",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/root/.claude"
  },
  "mounts": [
    "source=${localWorkspaceFolderBasename}-gradle,target=/root/.gradle,type=volume",
    "source=${localWorkspaceFolderBasename}-pub,target=/root/.pub-cache,type=volume",
    // gh credentials for the CI watcher.
    "source=${localEnv:HOME}/.config/gh,target=/root/.config/gh,type=bind,readonly",
    // Claude Code state, per repo folder and outside the repo.
    "source=${localEnv:HOME}/claude-state/${localWorkspaceFolderBasename},target=/root/.claude,type=bind,consistency=cached"
  ],
  "runArgs": [
    "--network=host"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "dart.flutterSdkPath": "/opt/flutter"
      }
    }
  }
}
